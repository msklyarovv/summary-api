# База данных
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/summary_api"

# Приложение
NODE_ENV="development"
PORT=3000

# GraphQL
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# Лимит сложности GraphQL-запросов (защита от abuse)
GRAPHQL_MAX_COMPLEXITY=50

# Rate limiting (запросов в минуту с одного IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
