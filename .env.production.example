# ─── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=summary_api
POSTGRES_USER=postgres
# Обязательно задать надёжный пароль!
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/summary_api

# ─── Приложение ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── GraphQL ──────────────────────────────────────────────────────────────────
# В production introspection рекомендуется отключить (безопасность схемы)
GRAPHQL_INTROSPECTION=false
GRAPHQL_MAX_COMPLEXITY=50

# ─── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
