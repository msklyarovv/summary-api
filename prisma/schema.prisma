generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(cuid())
  name        String
  description String       @db.Text
  email       String?
  phone       String?
  telegram    String?
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("profiles")
}

model Link {
  id        String  @id @default(cuid())
  label     String
  url       String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("links")
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  category  String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("skills")
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  stack        String[]
  order        Int       @default(0)
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experience")
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  url         String?
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}
